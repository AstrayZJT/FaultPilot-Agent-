# Local development credentials. Copy to .env before starting Docker Compose.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
FAULTPILOT_APP_PASSWORD=change-me-faultpilot
LAB_SERVICE_PASSWORD=change-me-lab-service
FAULTPILOT_DIAGNOSTIC_PASSWORD=change-me-diagnostic
POSTGRES_HOST_PORT=55432
FAULTPILOT_DB_URL=jdbc:postgresql://localhost:55432/faultpilot
LAB_DIAGNOSTIC_DB_URL=jdbc:postgresql://localhost:55432/faultpilot_lab
LAB_DIAGNOSTIC_DB_USERNAME=faultpilot_diagnostic
DATABASE_DIAGNOSTIC_QUERY_TIMEOUT_SECONDS=3
DATABASE_DIAGNOSTIC_MAX_ROWS=20
DATABASE_SLOW_QUERY_THRESHOLD_MILLIS=1000
DATABASE_HOLDING_QUERY_THRESHOLD_MILLIS=1000
TRACE_SLOW_SPAN_THRESHOLD_MILLIS=1000

# Local Redis laboratory. Production targets belong in the FaultPilot Redis service catalog.
LAB_REDIS_HOST=localhost
LAB_REDIS_PORT=56379
LAB_REDIS_PASSWORD=change-me-lab-redis
LAB_REDIS_USERNAME=
LAB_REDIS_DATABASE=0
REDIS_HOST_PORT=56379

# Qwen OpenAI-compatible API. Keep the real key outside the repository.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_API_KEY=
FAULTPILOT_REQUIRE_REMOTE_MODEL=true

# Optional authenticated Arthas source-location diagnostics.
# Keep the password outside Git and bind Arthas to the local diagnostic network.
ORDER_SERVICE_ARTHAS_URL=
ORDER_SERVICE_ARTHAS_USERNAME=
ORDER_SERVICE_ARTHAS_PASSWORD=
ORDER_SERVICE_CODE_PACKAGE_PREFIX=
INVENTORY_SERVICE_ARTHAS_URL=
INVENTORY_SERVICE_ARTHAS_USERNAME=
INVENTORY_SERVICE_ARTHAS_PASSWORD=
INVENTORY_SERVICE_CODE_PACKAGE_PREFIX=

# Optional Jaeger Query trace correlation. Configure a named backend under faultpilot.trace.jaeger.
ORDER_SERVICE_TRACE_REF=
ORDER_SERVICE_TRACE_SERVICE_NAME=order-service
INVENTORY_SERVICE_TRACE_REF=
INVENTORY_SERVICE_TRACE_SERVICE_NAME=inventory-service
